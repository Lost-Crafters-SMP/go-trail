capture:
  capture_start_wall: "1970-01-01T00:00:00Z"
  diagnostics:
    replay_diagnostics[1]{line,message,parent_span_id,span_id,trace_id,type}:
      "0",parent missing or started after child,"4444444444444444","3333333333333333","11111111111111111111111111111111",unresolved_parent
  ended_span_durations:
    count: "1"
    max_nanos: "0"
    min_nanos: "0"
    total_nanos: "0"
  ended_span_status_counts:
    error: "0"
    ok: "0"
    unset: "1"
  events_total: "1"
  header:
    format: trail
    version: 1
  last_record_elapsed_nanos: "1"
  last_record_seq: "6"
  loss_accounting:
    derived_per_span_losses:
      dropped_attributes: "0"
      dropped_events: "0"
      dropped_status_updates: "0"
      spans_with_drops: "0"
    live_spans: "1"
  observed_elapsed_nanos: "1"
  path: capture.trail.jsonl
  spans_ended: "1"
  spans_total: "2"
  spans_unended: "1"
  traces_completed: "0"
  traces_incomplete: "1"
  traces_total: "1"
  traces_unresolved: "0"
schema_version: trail.cli.v1
